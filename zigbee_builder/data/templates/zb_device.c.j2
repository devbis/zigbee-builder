{% for epid, cl, at in items %}
	{ {{ epid }}, {{ cl.cat.id }}, {{ at.a.id }}, ZCL_DATA_TYPE_{{ at.a.type }}, &{{ at.var }}, sizeof({{ at.var }}), {{ 'true' if at.a.c_type.startswith('s') else 'false' }}, (s32){{ '(%s)0x%X' % (at.a.c_type, at.a.invalid) if at.a.c_type.startswith('s') else '0x%X' % at.a.invalid }} },
{% endfor %}
};
{% endif %}

/* Defaults for a coordinator that never configures reporting; its configuration wins. */
static void reporting_defaults(void)
{
{% for o in onoffs %}
	app_reporting_default({{ o.ep }}, ZCL_CLUSTER_GEN_ON_OFF, ZCL_ATTRID_ONOFF, ZCL_DATA_TYPE_BOOLEAN, {{ o.report.min }}U, {{ o.report.max }}U, 0U);
{% endfor %}
{% for epid, cl, at in defaults %}
	app_reporting_default({{ epid }}, {{ cl.cat.id }}, {{ at.a.id }}, ZCL_DATA_TYPE_{{ at.a.type }},
			      {{ at.report.min }}U, {{ at.report.max }}U, {{ at.report.change }}U);
{% endfor %}
}

/*
 * Runs on the Zigbee thread, where attributes must be set. Joined and deep
 * sleeping: one measurement and report per wake, then no timer is left and the
 * stack puts the device to sleep. Otherwise it repeats.
 */
static int measure_tick(void *arg)
{
	ARG_UNUSED(arg);

	measure();
{% if ias %}
	zbr_ias_poll();
{% endif %}

{% if sleepy %}
{% if items %}
#if defined(CONFIG_ZIGBEE_SLEEPY_DEEP)
	if (zb_isDeviceJoinedNwk()) {
		zbr_report_all(report_items, ARRAY_SIZE(report_items), ZBR_WAKE_PERIOD_S);
{% if ias %}
		if (zbr_ias_pending()) {
			return 500;
		}
{% endif %}
		return -1;
	}
#else
	report_handler();
#endif
{% else %}
#if defined(CONFIG_ZIGBEE_SLEEPY_DEEP)
	if (zb_isDeviceJoinedNwk()) {
{% if ias %}
		if (zbr_ias_pending()) {
			return 500;
		}
{% endif %}
		return -1;
	}
#endif
{% endif %}
{% else %}
	/* Awake all the time: the stack's own reporting table does the work */
	report_handler();
{% endif %}
	return MEASURE_PERIOD_MS;
}

void zbr_network_left(void)
{
{% for z in ias %}
	zbr_ias_reset(&{{ z.var }});
{% endfor %}
	zb_user_network_left();
}

{% if writes %}
/* The coordinator wrote an attribute that is a datapoint of the MCU: send it, and take the value as the
 * channel's until the MCU reports (the measure loop would put the old one back otherwise). A value the
 * map does not know is not sent; the loop puts the channel's value back. */
static void zb_mcu_write(u8 ep, u16 cluster, u16 attr, u8 type, const u8 *data)
{
{% for w in writes %}
	if (ep == {{ w.ep }} && cluster == {{ w.cluster }} && attr == {{ w.attr }}) {
		if (type != ZCL_DATA_TYPE_{{ w.zcl_type }}) {
			return;     /* the stack refused it: wrong type */
		}
		{{ w.c_type }} val;
		int32_t raw;
		bool known = true;

		memcpy(&val, data, sizeof(val));
{% if w.map %}
		switch (val) {
{% for av, dv in w.map %}
		case {{ av }}:
			raw = {{ dv }};
			break;
{% endfor %}
		default:
			raw = 0;
			known = false;
			break;
		}
{% else %}
		raw = zbr_dp_unscale((int32_t)val, {{ w.mul }}, {{ w.den2 }});
{% if w.lo is not none %}
		raw = CLAMP(raw, {{ w.lo }}, {{ w.hi }});
{% endif %}
{% endif %}
		if (known) {
			uint8_t buf[IOTDRV_TUYA_MAX_DATA];
			int n = iotdrv_tuya_dp_encode_u32(buf, sizeof(buf), {{ w.dp }}, {{ w.dp_type }}, (uint32_t)raw);

			if (n > 0) {
				(void)iotdrv_tuya_mcu_send_dp(&{{ w.comp }}_mcu, buf, (size_t)n);
			}
			{{ w.comp }}_{{ w.chan }} = zbr_dp_scale(raw, {{ w.num }}, {{ w.den }});
			{{ w.comp }}_{{ w.chan }}_valid = true;
		}
		return;
	}
{% endfor %}
}

{% endif %}
static void zcl_hook(zclIncoming_t *in)
{
{% if writes %}
	if (in->hdr.cmd == ZCL_CMD_WRITE || in->hdr.cmd == ZCL_CMD_WRITE_UNDIVIDED ||
	    in->hdr.cmd == ZCL_CMD_WRITE_NO_RSP) {
		const zclWriteCmd_t *w = in->attrCmd;

		for (u8 i = 0; i < w->numAttr; i++) {
			zb_mcu_write(in->msg->indInfo.dst_ep, in->msg->indInfo.cluster_id, w->attrList[i].attrID,
				     w->attrList[i].dataType, w->attrList[i].attrData);
		}
	}
{% endif %}
{% for c in customs %}
	if ((in->hdr.cmd == ZCL_CMD_WRITE || in->hdr.cmd == ZCL_CMD_WRITE_UNDIVIDED ||
	     in->hdr.cmd == ZCL_CMD_WRITE_NO_RSP) && in->msg->indInfo.cluster_id == {{ c.id }}) {
{% if c.persisted %}
		{{ c.var }}_save();
{% endif %}
		zb_{{ c.name }}_on_write();
	}
{% endfor %}
{% if ias %}
	zbr_ias_hook(in);
{% else %}
	ARG_UNUSED(in);
{% endif %}
}

{% for ep in eps %}
static zcl_specClusterInfo_t ep{{ ep.id }}_clusters[{{ [(COMMON if ep.first else 0) + ep.clusters | length, 1] | max }}U];
{% endfor %}

void app_device_register(void)
{
	size_t n;

{% for c in comps.values() if c.kind == 'relay' %}
	if (gpio_is_ready_dt(&{{ c.id }}_gpio)) {
		(void)gpio_pin_configure_dt(&{{ c.id }}_gpio, GPIO_OUTPUT_INACTIVE);
	}
{% endfor %}
{% for c in comps.values() if c.kind == 'energy_meter' %}
	{{ c.id }}_restore();
{% endfor %}
{% for c in comps.values() if c.kind == 'tuya_mcu' %}
	iotdrv_tuya_mcu_init(&{{ c.id }}_mcu, 0U);
	iotdrv_tuya_mcu_add_listener(&{{ c.id }}_mcu, &{{ c.id }}_listener);
	if (iotdrv_tuya_uart_bind(DEVICE_DT_GET(DT_NODELABEL({{ c.uart_node }})), &{{ c.id }}_mcu) == 0) {
		(void)iotdrv_tuya_mcu_start(&{{ c.id }}_mcu);
	}
{% endfor %}
{% for c in comps.values() if c.kind == 'pwm_light' %}
	{{ c.id }}_light.ep = {{ c.ep }};
{% if c.onoff_var is defined %}
	{{ c.id }}_light.onoff = &{{ c.onoff_var }};
{% endif %}
	zbr_light_init(&{{ c.id }}_light);
{% endfor %}

	app_zcl_init(zcl_hook);
{% for o in onoffs %}
	zbr_onoff_init(&{{ o.var }});
{% endfor %}
{% for z in ias %}
	zbr_ias_init(&{{ z.var }});
{% endfor %}
{% for c in customs if c.persisted %}
	{{ c.var }}_load();
{% endfor %}

{% for ep in eps %}
	n = 0U;
{% if ep.first %}
	app_common_clusters(ep{{ ep.id }}_clusters);
	n = APP_COMMON_CLUSTER_NUM;
{% endif %}
{% for cl in ep.clusters %}
	ep{{ ep.id }}_clusters[n++] = (zcl_specClusterInfo_t){
		.clusterId = {{ cl.cat.id }},
{% if cl.custom %}
		.manuCode = {{ cl.custom.manu }},
{% endif %}
		.attrNum = ARRAY_SIZE({{ cl.var }}_attrs),
		.attrTbl = {{ cl.var }}_attrs,
		.clusterRegisterFunc = {{ cl.cat.register }},
{% if cl.ias %}
		.clusterAppCb = zbr_ias_cmd,
{% elif cl.onoff %}
		.clusterAppCb = zbr_onoff_cmd,
{% elif cl.light_kind == 'light_level' %}
		.clusterAppCb = zbr_light_level_cmd,
{% elif cl.light_kind == 'light_color' %}
		.clusterAppCb = zbr_light_color_cmd,
{% endif %}
	};
{% endfor %}
	app_endpoint_add({{ ep.id }}, &ep{{ ep.id }}_desc, ep{{ ep.id }}_clusters, n);
{% endfor %}

	app_reporting_restore();
	reporting_defaults();
	zb_user_init();
{% if inputs_used %}
	zbr_input_init(inputs, ARRAY_SIZE(inputs));
{% endif %}

	/* A deep-sleeping device starts over on every wake: the server's Image Notify drives it */
	zbr_ota_start(&ep{{ eps[0].id }}_desc, {{ 'false' if sleepy else 'true' }});

	(void)ev_timer_taskPost(measure_tick, NULL, {{ 'FIRST_MEASURE_MS' if sleepy else '10' }});
}
