&pinctrl {
	i2c0_zbr_default: i2c0_zbr_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, {{ sda_pin.port }}, {{ sda_pin.num }})>,
				<NRF_PSEL(TWIM_SCL, {{ scl_pin.port }}, {{ scl_pin.num }})>;
			bias-pull-up;
		};
	};

	i2c0_zbr_sleep: i2c0_zbr_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, {{ sda_pin.port }}, {{ sda_pin.num }})>,
				<NRF_PSEL(TWIM_SCL, {{ scl_pin.port }}, {{ scl_pin.num }})>;
			low-power-enable;
		};
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c0_zbr_default>;
	pinctrl-1 = <&i2c0_zbr_sleep>;
	pinctrl-names = "default", "sleep";
};
