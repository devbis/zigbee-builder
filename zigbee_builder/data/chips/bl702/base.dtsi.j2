#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pinctrl/bl702x-pinctrl.h>

/*
 * The flash map of MCUboot (the same as in its board overlay): the boot header 0..0x2000 (written by the
 * flashing tool), MCUboot at 0x2000, slot 0 at 0x20000, slot 1 at 0x88000. The application is linked into
 * slot 0 (the flash window is identity-mapped: the start code of the SoC sets the flash offset to 0).
 *
 * The Zigbee NV is an NVS volume, and looking up an absent key walks every sector of it: the 512 KB
 * partition of the board makes the start-up after a reset take about a minute on the single-line flash
 * of the BL702. Eight sectors from the unused end of the flash make it take milliseconds.
 */
&kh25v80 {
	partitions {
		/delete-node/ partition@2000;
		/delete-node/ partition@80000;

		boot_partition: partition@2000 {
			compatible = "zephyr,mapped-partition";
			label = "mcuboot";
			reg = <0x00002000 0x0001e000>;
			read-only;
		};

		slot0_partition: partition@20000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x00020000 0x00068000>;
		};

		slot1_partition: partition@88000 {
			compatible = "zephyr,mapped-partition";
			label = "image-1";
			reg = <0x00088000 0x00068000>;
		};

		storage_partition: partition@f8000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x000f8000 0x00008000>;
		};
	};
};
{% for p in ports %}

&{{ p }} {
	status = "okay";
};
