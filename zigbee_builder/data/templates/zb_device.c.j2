/* milli-degC and milli-percent */
static bool {{ c.id }}_read(void)
{
	struct sensor_value t, h;

	if (!device_is_ready({{ c.id }}_dev) || sensor_sample_fetch({{ c.id }}_dev) != 0 ||
	    sensor_channel_get({{ c.id }}_dev, SENSOR_CHAN_AMBIENT_TEMP, &t) != 0 ||
	    sensor_channel_get({{ c.id }}_dev, SENSOR_CHAN_HUMIDITY, &h) != 0) {
		return false;
	}
	{{ c.id }}_temperature = t.val1 * 1000 + t.val2 / 1000;
	{{ c.id }}_humidity = h.val1 * 1000 + h.val2 / 1000;
	return true;
}
{% elif c.kind == 'battery_adc' %}
static const struct adc_dt_spec {{ c.id }}_adc = ADC_DT_SPEC_GET_BY_IDX(DT_PATH(zephyr_user), 0);
static int32_t {{ c.id }}_voltage, {{ c.id }}_percent;

/* millivolts and milli-percent (linear between the empty and the full voltage) */
static bool {{ c.id }}_read(void)
{
	int16_t mv = 0;
	struct adc_sequence seq = {.buffer = &mv, .buffer_size = sizeof(mv)};

	if (!adc_is_ready_dt(&{{ c.id }}_adc) || adc_channel_setup_dt(&{{ c.id }}_adc) != 0 ||
	    adc_sequence_init_dt(&{{ c.id }}_adc, &seq) != 0 || adc_read_dt(&{{ c.id }}_adc, &seq) != 0) {
		return false;
	}
{% if c.raw_to_mv %}
	{
		/* the ADC gives raw counts: scale them by the gain, the reference and the resolution */
		int32_t v = mv;

		if (adc_raw_to_millivolts_dt(&{{ c.id }}_adc, &v) != 0) {
			return false;
		}
		mv = (int16_t)v;
	}
{% endif %}
	if (mv <= 0) {
		return false;
	}
	{{ c.id }}_voltage = mv;
	{{ c.id }}_percent = CLAMP(((int32_t)mv - {{ c.empty_mv }}) * 100000 / ({{ c.full_mv }} - {{ c.empty_mv }}), 0, 100000);
	return true;
}
