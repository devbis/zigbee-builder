/* Generated by zigbee-builder for {{ name }}. Do not edit. */
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
{% for p in ports %}

&{{ p }} {
	status = "okay";
};
{% endfor %}

/* Free the board's fixed I2C pins unless a YAML bus requests that controller. */
&i2c1 {
	status = "disabled";
};

/ {
	chosen {
		zephyr,ieee802154 = &ieee802154;
{% if sleepy %}
		zigbee,retained-mem = &zigbee_retained_bkp;
{% endif %}
	};
};

/* CPU2 runs the Thread RCP; do not initialize the BLE radio driver on CPU1. */
&ble_rf {
	status = "disabled";
};

&ieee802154 {
	status = "okay";
};

/* The application and MCUboot must use the same M4 flash map. */
/delete-node/ &boot_partition;
/delete-node/ &slot0_partition;
/delete-node/ &slot1_partition;
/delete-node/ &scratch_partition;
/delete-node/ &storage_partition;

&flash0 {
	partitions {
		boot_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(80)>;
		};

		slot0_partition: partition@14000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x00014000 DT_SIZE_K(360)>;
		};

		storage_partition: partition@6e000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x0006e000 DT_SIZE_K(32)>;
		};

		slot1_partition: partition@76000 {
			compatible = "zephyr,mapped-partition";
			label = "image-1";
			reg = <0x00076000 DT_SIZE_K(328)>;
		};
	};
};

{% if sleepy %}
&standby {
	status = "okay";
};

/ {
	zigbee_retained_bkp: zigbee_retained_bkp {
		compatible = "st,stm32-bkp-retained";
		first-register = <0>;
		size = <8>;
	};
};
{% endif %}
