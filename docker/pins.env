# What the image is built from. Revisions are commits, so the image can be built again as it was.
# The repositories are public.
ZEPHYR_REPO=https://github.com/devbis/zephyr-tlsr8258
ZEPHYR_REV=18710f8775b2ec57e53dd8beafbdcaa30e9ed03e         # branch zigbee-generic-stack
IOT_DRIVERS_REPO=https://github.com/devbis/zephyr-iot-drivers
IOT_DRIVERS_REV=ab2ad7c80e737db4791d598c0d9611a0ba25b2f9    # branch main
# The TC32 LLVM: the binary release of the fork (its tag is the commit 689747b, branch tc32), not built here.
TC32_LLVM_TAG=23.1.3-tc32-20261008
TC32_LLVM_SHA256_ARM64=2670b51355599b252e90992833058ca68fb11f913cff5dc6820b65be301997d1
TC32_LLVM_SHA256_AMD64=251b1c14efc71baae00c99cd84b528b48a4a0b657e7a9709a2fe3e595062cac8
# MCUboot: the fork's manifest names a branch (tc32-port), so its commit is pinned here
MCUBOOT_REPO=https://github.com/modern-tc32/mcuboot
MCUBOOT_REV=04817d6372b89a939cbd0dee33cf3e56bbba5fc4
ZEPHYR_SDK_VERSION=1.0.1
# The west projects of the Zephyr workspace the chips need (their revisions come from the fork's manifest)
WEST_PROJECTS="cmsis cmsis_6 hal_espressif hal_nordic mbedtls mcuboot segger tf-psa-crypto tf-psa-crypto-drivers zcbor"
