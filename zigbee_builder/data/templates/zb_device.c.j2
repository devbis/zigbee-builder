/* ---- measurement --------------------------------------------------- */
static void measure(void)
{
	zb_user_measure();
{% for c in comps.values() if c.kind not in ('binary_input', 'relay', 'pwm_light') %}
	bool ok_{{ c.id }} = {{ c.id }}_read();
{% endfor %}

{% for b in bindings %}
	if (ok_{{ ident(b.comp) }}{% if comps[b.comp].chan_valid is defined %} && {{ ident(b.comp) }}_{{ b.chan }}_valid{% endif %}) {
{% if b.map %}
		bool known = false;
		{{ b.attr.a.c_type }} v = 0;

		/* a datapoint value the map does not name leaves the attribute as it is */
		switch ({{ ident(b.comp) }}_{{ b.chan }} / 1000) {
{% for k, val in b.map %}
		case {{ k }}:
			v = {{ val }};
			known = true;
			break;
{% endfor %}
		default:
			break;
		}
{% elif b.attr.a.c_type == 'float' %}
		u32 v = zbr_float_bits({{ ident(b.comp) }}_{{ b.chan }}, {{ b.div }}U);
{% else %}
		{{ b.attr.a.c_type }} v = ({{ b.attr.a.c_type }})CLAMP({{ ident(b.comp) }}_{{ b.chan }} / {{ b.div }}, {{ b.attr.a.min }}, {{ b.attr.a.max }});
{% endif %}

		if ({% if b.map %}known && {% endif %}v != {{ b.var }}) {
			{{ b.var }} = v;
			zcl_setAttrVal({{ b.ep }}, {{ b.cluster.cat.id }}, {{ b.attr.a.id }}, (u8 *)&{{ b.var }});
		}
	}
{% endfor %}
}

