&pinctrl {
	i2c0_sda: i2c0_sda {
		pinmux = <TLSR8258_PINMUX(TLSR8258_GPIO_{{ sda }}, TLSR8258_FUNC_I2C)>;
		bias-pull-up;
		input-enable;
		output-enable;
	};

	i2c0_scl: i2c0_scl {
		pinmux = <TLSR8258_PINMUX(TLSR8258_GPIO_{{ scl }}, TLSR8258_FUNC_I2C)>;
		bias-pull-up;
		input-enable;
		output-enable;
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	pinctrl-0 = <&i2c0_sda &i2c0_scl>;
};
