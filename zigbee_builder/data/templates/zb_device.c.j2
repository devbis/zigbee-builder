static u32 {{ c.id }}_saved_wh;

/* thousandths: mV, mA, mW, and Wh (the energy channel is kWh) */
static int32_t {{ c.id }}_milli(const struct sensor_value *v)
{
	return v->val1 * 1000 + v->val2 / 1000;
}

/* Give the driver the energy total it had before the reset (it lives in RAM there) */
static void {{ c.id }}_restore(void)
{
	u32 wh;
	struct sensor_value v;

	if (zbr_store_load({{ c.store_item }}, &wh, sizeof(wh))) {
		v.val1 = wh / 1000U;
		v.val2 = (wh % 1000U) * 1000;
		(void)sensor_attr_set({{ c.id }}_dev, IOTDRV_SENSOR_CHAN_ENERGY, IOTDRV_SENSOR_ATTR_ENERGY_TOTAL, &v);
		{{ c.id }}_saved_wh = wh;
	}
}

static bool {{ c.id }}_read(void)
{
	struct sensor_value v;

	if (!device_is_ready({{ c.id }}_dev) || sensor_sample_fetch({{ c.id }}_dev) != 0) {
		return false;
	}
	if (sensor_channel_get({{ c.id }}_dev, SENSOR_CHAN_VOLTAGE, &v) == 0) {
		{{ c.id }}_voltage = {{ c.id }}_milli(&v);
	}
	if (sensor_channel_get({{ c.id }}_dev, SENSOR_CHAN_CURRENT, &v) == 0) {
		{{ c.id }}_current = {{ c.id }}_milli(&v);
	}
	if (sensor_channel_get({{ c.id }}_dev, SENSOR_CHAN_POWER, &v) == 0) {
		{{ c.id }}_power = {{ c.id }}_milli(&v);
	}
	if (sensor_channel_get({{ c.id }}_dev, IOTDRV_SENSOR_CHAN_ENERGY, &v) == 0) {
		{{ c.id }}_energy = {{ c.id }}_milli(&v);
		/* A save per {{ c.persist_step_wh }} Wh: a power cut loses at most that */
		if ((u32){{ c.id }}_energy >= {{ c.id }}_saved_wh + {{ c.persist_step_wh }}U) {
			u32 wh = (u32){{ c.id }}_energy;

			zbr_store_save({{ c.store_item }}, &wh, sizeof(wh));
			{{ c.id }}_saved_wh = wh;
		}
	}
	return true;
}
