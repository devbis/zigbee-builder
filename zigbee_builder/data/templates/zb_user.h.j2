/*
 * Generated by zigbee-builder. The API of the C plugins of {{ name }}: read and write the
 * attributes of the custom clusters, send their commands, and the hooks to implement.
 * Every hook is optional (a weak default does nothing).
 *
 * Plugins run on the Zigbee thread. Include the Zephyr headers before this one if you use them.
 */
#pragma once

#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>

#include "zbr_timer.h"     /* zb_after(ms, fn, arg), zb_cancel(handle): one-shot timers on the Zigbee thread */

/* Once at boot, after the endpoints are registered */
void zb_user_init(void);
/* The device left its network and the NV was erased: reset what you keep from the old one */
void zb_user_network_left(void);
/* Before every measurement tick's reports: update attributes here */
void zb_user_measure(void);
{% for c in customs %}

/* ---- custom cluster {{ c.name }} ({{ c.id }}, endpoint {{ c.ep }}) ---- */
{% for at in c.attrs %}
{{ at.api }} zb_{{ c.name }}_get_{{ at.name }}(void);
void zb_{{ c.name }}_set_{{ at.name }}({{ at.api }} value);
{% endfor %}
/* The coordinator wrote one or more attributes (already stored and persisted) */
void zb_{{ c.name }}_on_write(void);
/* A cluster specific command arrived; return a ZCL status (0 = success, 0x81 unsupported command) */
uint8_t zb_{{ c.name }}_on_command(uint8_t cmd, const uint8_t *data, uint16_t len);
/* Send a cluster specific command to the bindings of the endpoint */
void zb_{{ c.name }}_send(uint8_t cmd, const uint8_t *data, uint16_t len);
{% for id, n in c.commands %}
#define ZB_{{ c.name | upper }}_CMD_{{ n | upper }} {{ id }}
{% endfor %}
{% endfor %}
{% for c in comps.values() if c.kind == 'relay' %}

/* ---- relay {{ c.id }} ---- */
/* Switch it: the OnOff attribute (if the relay has an endpoint), a pulse and the saved state follow */
void zb_relay_{{ c.id }}_set(bool on);
bool zb_relay_{{ c.id }}_get(void);
{% endfor %}
{% for c in comps.values() if c.kind == 'binary_input' %}

/* ---- input {{ c.id }} ---- */
/* Its level changed (after the debounce and the release delay); implement it to react */
void zb_input_{{ c.id }}_on_change(bool active);
bool zb_input_{{ c.id }}_get(void);
{% endfor %}
